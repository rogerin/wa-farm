# ==============================================================================
# wa-android-farm — Configuração de Ambiente (.env.example)
# Copie para .env se quiser customizar: cp .env.example .env
# ==============================================================================

# Quantidade de contas de WhatsApp / emuladores (wa_01 até wa_0N)
WA_MAX_ACCOUNTS=7

# Memória RAM máxima por emulador em MB (768 a 1024 recomendado)
WA_RAM_MB=896

# Tamanho do VM Heap do Android em MB
WA_HEAP_MB=96

# Quantidade de núcleos de CPU por emulador
WA_CPU_CORES=1

# Resolução e densidade de tela (360x640 @ 160dpi reduz VRAM em 90%)
WA_LCD_WIDTH=360
WA_LCD_HEIGHT=640
WA_LCD_DENSITY=160

# Nível da API do Android AOSP (31 = Android 12 puro sem Google Play Services)
WA_ANDROID_API=31

# Tamanho da partição de dados de cada emulador
WA_DATA_SIZE=2048M

# URL oficial de download direto do APK do WhatsApp
WA_APK_URL=https://www.whatsapp.com/android/current/WhatsApp.apk
